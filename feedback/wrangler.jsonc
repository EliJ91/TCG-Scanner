{
  "name": "cardslinger-feedback",
  "main": "worker.ts",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SCANNER_URL": "https://elij91.github.io/TCG-Scanner/",
    "OWNER_GITHUB_ID": "59631669"
  },
  "kv_namespaces": [
    { "binding": "FEEDBACK" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "FEEDBACK_LIMIT", "class_name": "FeedbackLimits" }]
  },
  "migrations": [
    { "tag": "feedback-limits-v1", "new_sqlite_classes": ["FeedbackLimits"] }
  ],
  "ratelimits": [
    { "name": "SUBMISSION_LIMIT", "namespace_id": "59631669", "simple": { "limit": 1, "period": 60 } }
  ]
}
