{
  "name": "cardslinger-feedback",
  "main": "worker.ts",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SCANNER_URL": "https://elij91.github.io/TCG-Scanner/",
